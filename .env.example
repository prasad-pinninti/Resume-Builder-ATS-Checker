# DATABASE: Set MONGODB_URI to connect to a persistent MongoDB database.
# If omitted, the app will automatically spin up an in-memory MongoDB server.
MONGODB_URI=""

# AI MODEL CONFIGURATION (Using Groq API)
# Configure GROQ_API_KEY and set your preferred model (e.g. llama-3.3-70b-versatile)
GROQ_API_KEY=""
OPENAI_MODEL="llama-3.3-70b-versatile"

# IMAGEKIT CONFIGURATION (For uploading profile pictures and images)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# AUTHENTICATION
JWT_SECRET="super_secret_jwt_token_key"
